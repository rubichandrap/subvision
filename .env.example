# Read by `docker compose` (project root), not by the services themselves.

# Where the Parakeet model files live on the host.
#PARAKEET_MODEL_DIR=./models/parakeet

# Vocal isolation before transcription (experiment, ADR-0013). 0 = off (default).
# 1 builds Demucs into the ASR image and separates the vocals before decoding.
# Costs ~100 s and up to ~3 GB RAM per 3-minute song and ~2 GB more image, so also raise
# PARAKEET_TIMEOUT_SECONDS in server/.env (e.g. 900), then rebuild: see asr/worker/README.md.
ASR_VOCAL_ISOLATION=0
