PORT=8080
TMP_DIR=/tmp

CLIENT_URL=http://localhost:3000

S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfs
S3_SECRET_KEY=rustfs123
S3_BUCKET=subvision

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Default to third_party/whisper.cpp/bindings/go/models/*.bin
WHISPER_MODEL_PATH=third_party/whisper.cpp/bindings/go/models/ggml-base.en.bin

# Optional: gate decoding on detected speech — ffmpeg silencedetect finds the
# silence and only speech windows are decoded (ADR-0007). Unset keeps the
# whole audio decoded in one pass.
# VAD_GATING=true
