PORT=8080
TMP_DIR=/tmp

CLIENT_URL=http://localhost:3000

S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfs
S3_SECRET_KEY=rustfs123
S3_BUCKET=subvision

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Required: HTTP endpoint of the Parakeet ASR worker.
# Compose sets this to http://asr:8081/transcribe automatically.
PARAKEET_URL=http://127.0.0.1:8081/transcribe

# Optional Parakeet decode ceiling in seconds (default 60).
#PARAKEET_TIMEOUT_SECONDS=60
